#=====================================================================#
#           Enterprise LibreChat Configuration                        #
#           Databricks AI Gateway + Azure AD SSO                      #
#=====================================================================#

#==================================================#
#               Server Configuration               #
#==================================================#

HOST=0.0.0.0
PORT=3080

MONGO_URI=mongodb://127.0.0.1:27017/LibreChat
# Production: Use Azure Cosmos DB connection string
# MONGO_URI=mongodb://user:password@yourcosmosdb.mongo.cosmos.azure.com:10255/LibreChat?ssl=true&replicaSet=globaldb&retrywrites=false

DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
# Production: Set to your actual domain
# DOMAIN_CLIENT=https://chat.yourcompany.com
# DOMAIN_SERVER=https://chat.yourcompany.com

NO_INDEX=true
TRUST_PROXY=1

#===============#
# JSON Logging  #
#===============#

# Production: Set to true for structured logging
CONSOLE_JSON=false

#===============#
# Debug Logging #
#===============#

DEBUG_LOGGING=true
DEBUG_CONSOLE=false
AGENT_DEBUG_LOGGING=false

#==================================================#
#                     Endpoints                    #
#==================================================#

# Only custom (Databricks) for now. Add 'agents' back when pre-built agents are ready.
ENDPOINTS=custom

#===================================#
# Databricks AI Gateway             #
#===================================#

DATABRICKS_API_KEY=
# Example: https://your-workspace.cloud.databricks.com/serving-endpoints/your-gateway/invocations/v1
DATABRICKS_GATEWAY_URL=

#==================================================#
#          Encryption & JWT (GENERATE NEW!)        #
#==================================================#
# Generate with: openssl rand -hex 32 (for CREDS_KEY, JWT secrets)
# Generate with: openssl rand -hex 16 (for CREDS_IV)

CREDS_KEY=REPLACE_WITH_openssl_rand_hex_32
CREDS_IV=REPLACE_WITH_openssl_rand_hex_16

JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_REFRESH_SECRET=REPLACE_WITH_openssl_rand_hex_32

SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7

#==================================================#
#                      Search                      #
#==================================================#

# Disabled — not needed for enterprise deployment
SEARCH=false

#==================================================#
#          Authentication & Registration           #
#==================================================#

# Local auth: Enabled for admin break-glass access only
ALLOW_EMAIL_LOGIN=true
# Registration disabled — admin created via CLI: npm run create-user
ALLOW_REGISTRATION=false
# Social login must be true for OpenID to load
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

#========================#
# Azure AD / Entra ID    #
# (OpenID Connect)       #
#========================#

OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_ISSUER=
# Example: https://login.microsoftonline.com/YOUR-TENANT-ID/v2.0
OPENID_SESSION_SECRET=REPLACE_WITH_openssl_rand_hex_32
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback

# Entra ID claim mapping
OPENID_EMAIL_CLAIM=upn
# OPENID_USERNAME_CLAIM=
# OPENID_NAME_CLAIM=

# UI customization
OPENID_BUTTON_LABEL=Sign in with Azure AD
# OPENID_IMAGE_URL=
OPENID_AUTO_REDIRECT=false

# PKCE (recommended for security)
OPENID_USE_PKCE=true

# Role-based access control via Azure AD groups
# OPENID_REQUIRED_ROLE=your-azure-ad-group-id
# OPENID_REQUIRED_ROLE_TOKEN_KIND=id
# OPENID_REQUIRED_ROLE_PARAMETER_PATH=groups

# Admin role mapping
# OPENID_ADMIN_ROLE=your-admin-group-id
# OPENID_ADMIN_ROLE_TOKEN_KIND=id
# OPENID_ADMIN_ROLE_PARAMETER_PATH=groups

# Microsoft Graph integration (for Entra ID people search)
# USE_ENTRA_ID_FOR_PEOPLE_SEARCH=true
# OPENID_GRAPH_SCOPES=User.Read,People.Read,GroupMember.Read.All
# OPENID_ON_BEHALF_FLOW_FOR_USERINFO_REQUIRED=true
# OPENID_ON_BEHALF_FLOW_USERINFO_SCOPE="user.read"

# Logout
# OPENID_USE_END_SESSION_ENDPOINT=true
# OPENID_POST_LOGOUT_REDIRECT_URI=

#========================#
# Moderation             #
#========================#

OPENAI_MODERATION=false
BAN_VIOLATIONS=true
BAN_DURATION=1000 * 60 * 60 * 2
BAN_INTERVAL=20

LOGIN_MAX=7
LOGIN_WINDOW=5
REGISTER_MAX=5
REGISTER_WINDOW=60

LIMIT_CONCURRENT_MESSAGES=true
CONCURRENT_MESSAGE_MAX=2

#========================#
# Shared Links           #
#========================#

ALLOW_SHARED_LINKS=true
ALLOW_SHARED_LINKS_PUBLIC=false

#==================================================#
#                        UI                        #
#==================================================#

APP_TITLE=Enterprise AI
# CUSTOM_FOOTER="Powered by Enterprise AI Platform"
HELP_AND_FAQ_URL=https://yourcompany.com/ai-help

#===============#
# REDIS Options #
#===============#

# Production: Enable for multi-instance scaling
# USE_REDIS=true
# REDIS_URI=redis://your-redis-host:6380

#==================================================#
#                        RAG                       #
#==================================================#

# RAG_API_URL=http://rag_api:8000
# RAG_OPENAI_BASEURL=
# RAG_OPENAI_API_KEY=
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=text-embedding-3-small

#==================================================#
#               File Storage                       #
#==================================================#

# Azure Blob Storage (production)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_PUBLIC_ACCESS=false
# AZURE_CONTAINER_NAME=files

# Or S3-compatible
# AWS_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET_NAME=

#==================================================#
#            Langfuse Tracing (Optional)           #
#==================================================#

# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
